[Unit]
Description=Mini Arcade visit statistics
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=mini-arcade-stats
WorkingDirectory=/opt/mini-arcade-stats
ExecStart=/usr/bin/python3 /opt/mini-arcade-stats/stats_server.py --port 46175 --db /var/lib/mini-arcade-stats/visits.sqlite3 --catalog /var/www/mini-arcade/games.json --allow-origin https://arcade.venai.cn
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
